{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "definitions": {
    "asr": "100 * attack_success_count / clean_correct_count; denominator excludes clean-incorrect samples",
    "budgets": {
      "B0": "count_i[dt_i != 0]",
      "B1": "sum_i |dt_i|",
      "B_inf": "max_i |dt_i|"
    }
  },
  "properties": {
    "adversarial_accuracy": {
      "maximum": 100,
      "minimum": 0,
      "type": "number"
    },
    "asr": {
      "maximum": 100,
      "minimum": 0,
      "type": "number"
    },
    "attack_success_count": {
      "type": "integer"
    },
    "attack_time_s_mean": {
      "type": "number"
    },
    "audit_pass": {
      "const": true,
      "type": "boolean"
    },
    "b0_max": {
      "type": "number"
    },
    "b1_max": {
      "type": "number"
    },
    "b_inf_max": {
      "type": "number"
    },
    "beta": {
      "type": "integer"
    },
    "budget_type": {
      "enum": [
        "B_inf",
        "B1",
        "B0"
      ],
      "minLength": 1,
      "type": "string"
    },
    "changed_event_ratio": {
      "type": "number"
    },
    "checkpoint_sha256": {
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "clean_accuracy": {
      "maximum": 100,
      "minimum": 0,
      "type": "number"
    },
    "clean_correct_count": {
      "type": "integer"
    },
    "comparison_status": {
      "enum": [
        "PAPER_COMPARABLE",
        "NON_COMPARABLE"
      ],
      "minLength": 1,
      "type": "string"
    },
    "config_sha256": {
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "dataset": {
      "minLength": 1,
      "type": "string"
    },
    "frame_l0": {
      "type": "number"
    },
    "frame_l1": {
      "type": "number"
    },
    "frame_l2": {
      "type": "number"
    },
    "frame_linf": {
      "type": "number"
    },
    "gpu_time_s_mean": {
      "type": "number"
    },
    "log_path": {
      "minLength": 1,
      "type": "string"
    },
    "mean_abs_dt": {
      "type": "number"
    },
    "model": {
      "minLength": 1,
      "type": "string"
    },
    "n_attacked": {
      "type": "integer"
    },
    "queries_mean": {
      "type": "number"
    },
    "representation": {
      "enum": [
        "binary",
        "integer"
      ],
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "seed": {
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "dataset",
    "model",
    "representation",
    "seed",
    "budget_type",
    "beta",
    "n_attacked",
    "clean_correct_count",
    "attack_success_count",
    "clean_accuracy",
    "adversarial_accuracy",
    "asr",
    "b_inf_max",
    "b1_max",
    "b0_max",
    "mean_abs_dt",
    "changed_event_ratio",
    "frame_l0",
    "frame_l1",
    "frame_l2",
    "frame_linf",
    "queries_mean",
    "attack_time_s_mean",
    "gpu_time_s_mean",
    "audit_pass",
    "checkpoint_sha256",
    "config_sha256",
    "log_path",
    "comparison_status"
  ],
  "title": "TEMP-DRIFT seed-level summary row",
  "type": "object"
}
