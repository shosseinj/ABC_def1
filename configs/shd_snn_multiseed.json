{
  "dataset": "SHD",
  "data_root": "data/shd",
  "seeds": [42, 123, 777, 2026, 6543],
  "split_seed": 42,
  "validation_fraction": 0.2,
  "input_channels": 700,
  "n_classes": 20,
  "duration_us": 1400000,
  "time_steps": 100,
  "representation": "dense binary occupancy preserving ordered spike-time bins and cochlear channel identity",
  "architecture": "Linear(700,128)-recurrent-LIF(128)-Linear(128,20), mean temporal readout",
  "hidden_size": 128,
  "neuron_type": "discrete recurrent leaky integrate-and-fire",
  "lif_decay": 0.9,
  "reset": "subtractive reset detached from gradient",
  "surrogate_gradient": "fast sigmoid with slope 5",
  "optimizer": "Adam",
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "batch_size": 128,
  "epochs": 40,
  "minimum_epochs": 15,
  "patience": 7,
  "gradient_clip_norm": 1.0,
  "checkpoint_selection": "highest validation accuracy, then lowest validation loss, then earliest epoch",
  "device": "cuda",
  "deterministic_algorithms": true,
  "cublas_workspace_config": ":4096:8",
  "attacks_enabled": false,
  "defenses_enabled": false,
  "qsnn_enabled": false
}
