{
  "dataset": "MNIST",
  "data_root": "data",
  "download": true,
  "split_seed": 42,
  "seed": 42,
  "train_per_class": 1000,
  "validation_per_class": 200,
  "image_size": 8,
  "downsampled_features": 64,
  "pca_dimensions": [16, 24, 32],
  "time_window": 100.0,
  "encoding": "TTFS latency then angle encoding",
  "n_qubits": 8,
  "reupload_blocks": 4,
  "feature_schedule": "cyclic 8-feature slices over the PCA features",
  "n_classes": 10,
  "optimizer": "Adam",
  "learning_rate": 0.003,
  "batch_size": 64,
  "max_epochs": 400,
  "minimum_early_stop_epoch": 20,
  "patience": 20,
  "gradient_clip_norm": 1.0,
  "weight_decay": 0.0,
  "checkpoint_rule": "lowest validation CE, then earliest epoch",
  "clear_accuracy_improvement": 0.01,
  "attacks_enabled": false,
  "defenses_enabled": false,
  "held_out_enabled": false
}
