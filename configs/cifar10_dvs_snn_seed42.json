{
  "dataset": "CIFAR10-DVS",
  "data_root": "data/cifar10_dvs",
  "split_seed": 42,
  "model_seed": 42,
  "train_split": 0.8,
  "validation_split": 0.1,
  "test_split": 0.1,
  "temporal_bins": 10,
  "input_shape": [128, 128],
  "sensor_size": [128, 128, 2],
  "polarity_channels": 2,
  "representation": "event-frame: sum events per polarity per temporal bin",
  "accumulation": "additive event count per bin",
  "normalization": "per-sample max normalization across all bins and channels",
  "n_classes": 10,
  "batch_size": 16,
  "max_epochs": 350,
  "early_stop_patience": 20,
  "optimizer": "AdamW",
  "learning_rate": 0.001,
  "weight_decay": 1e-4,
  "scheduler": {
    "type": "ReduceLROnPlateau",
    "mode": "max",
    "factor": 0.5,
    "patience": 8,
    "min_lr": 1e-6,
    "step_on": "validation_accuracy"
  },
  "checkpoint_rule": "highest validation accuracy, then lowest validation loss, then earliest epoch",
  "device": "cuda",
  "gradient_clip_norm": 1.0,
  "attacks_enabled": false,
  "defenses_enabled": false,
  "held_out_enabled": false
}