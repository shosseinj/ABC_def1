{
  "dataset": "N-MNIST",
  "data_root": "data/nmnist",
  "download_if_missing": true,
  "official_partition_used": "train",
  "held_out_partition": "official test (not instantiated)",
  "split_seed": 42,
  "model_seed": 42,
  "train_per_class": 200,
  "validation_per_class": 50,
  "sensor_size": [34, 34, 2],
  "spatial_grid": [2, 2],
  "polarity_channels": 2,
  "event_channels": 8,
  "temporal_bins": 8,
  "representation": "per-sample log-normalized event counts by temporal bin, pooled spatial cell, and polarity",
  "timestamp_policy": "equal-width bins over each sample's observed timestamp range",
  "temporal_order_preserved": true,
  "polarity_preserved": true,
  "n_qubits": 8,
  "temporal_reupload_steps": 8,
  "n_classes": 10,
  "optimizer": "Adam",
  "learning_rate": 0.003,
  "batch_size": 64,
  "max_epochs": 60,
  "minimum_early_stop_epoch": 20,
  "patience": 10,
  "gradient_clip_norm": 1.0,
  "weight_decay": 0.0,
  "checkpoint_rule": "lowest validation CE, then earliest epoch",
  "acceptable_validation_accuracy": 0.70,
  "acceptable_validation_macro_f1": 0.68,
  "acceptable_minimum_class_accuracy": 0.40,
  "attacks_enabled": false,
  "defenses_enabled": false,
  "held_out_enabled": false
}
