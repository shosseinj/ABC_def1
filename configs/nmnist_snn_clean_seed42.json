{
  "dataset": "N-MNIST",
  "data_root": "data/nmnist",
  "seed": 42,
  "split_seed": 42,
  "validation_per_class": 500,
  "official_training_partition_only_for_training": true,
  "official_test_accesses_allowed": 1,
  "input_representation": "10 ordered polarity-separated 34x34 event-count frames",
  "temporal_bins": 10,
  "sensor_size": [34, 34, 2],
  "polarity_preserved": true,
  "architecture": "Conv2d(2,16,3)-BN-LIF-AvgPool2; Conv2d(16,32,3)-BN-LIF-AvgPool2; Linear(2048,10)",
  "neuron_type": "discrete leaky integrate-and-fire with subtractive reset and fast-sigmoid surrogate gradient",
  "lif_decay": 0.5,
  "optimizer": "Adam",
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "batch_size": 128,
  "epochs": 15,
  "minimum_epochs": 8,
  "patience": 4,
  "gradient_clip_norm": 1.0,
  "checkpoint_selection": "highest validation accuracy, then lowest validation loss",
  "device": "cuda",
  "attacks_enabled": false,
  "defenses_enabled": false,
  "qsnn_enabled": false
}
